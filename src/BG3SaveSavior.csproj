<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>BG3FlaggedSaveSavior</AssemblyName>
    <!-- RootNamespace laissé tel quel (identifiant interne, invisible pour l'utilisateur) :
         renommer les namespaces C# est un refactor de code, pas une question de branding. -->
    <RootNamespace>BG3SaveSavior</RootNamespace>
    <Platforms>x64</Platforms>
    <Version>0.1.1</Version>
    <Product>BG3 Flagged Save Savior</Product>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- LSLib (Norbyte) : lecture/écriture native des packages .lsv et des ressources .lsf,
       la même bibliothèque utilisée par Divine.exe et BG3 Mod Manager. Référencées en DLL
       locales (pas de paquet NuGet officiel) depuis lib/, copiées telles quelles depuis la
       release GitHub v1.20.4. -->
  <ItemGroup>
    <Reference Include="LSLib">
      <HintPath>..\lib\LSLib.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <!-- Nécessaire en plus de <ApplicationIcon> ci-dessus : ApplicationIcon ne couvre que
       l'icône de l'exe lui-même (explorateur), <Resource> rend le fichier chargeable par
       Window.Icon="app.ico" dans le XAML (barre des tâches, Alt+Tab). Sans ça, le XAML ne
       trouve pas la ressource et l'app plante au démarrage (crash constaté le 2026-09-21). -->
  <ItemGroup>
    <Resource Include="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\lib\*.dll" Exclude="..\lib\LSLib.dll" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
